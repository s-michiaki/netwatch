<Window x:Class="NetWatch.CountryMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetWatch.ViewModels"
        Title="NetWatch — 国別の通信先マップ" Width="1380" Height="860" MinWidth="900" MinHeight="560"
        Background="{StaticResource Bg}" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:ShareWidthConverter x:Key="ShareWidth"/>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 上部：1 位の国と表示オプション -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="色の基準：" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <RadioButton Content="通信量" GroupName="metric" IsChecked="{Binding MetricIsBytes}"/>
                        <RadioButton Content="接続数" GroupName="metric" IsChecked="{Binding MetricIsConnections}"/>
                        <RadioButton Content="宛先 IP 数" GroupName="metric" IsChecked="{Binding MetricIsAddresses}"/>
                        <CheckBox Content="ローカルネットワークも含める" IsChecked="{Binding IncludeLocal}"/>
                        <Button Content="集計をリセット" Command="{Binding ResetCommand}"/>
                    </StackPanel>
                    <TextBlock Text="※ 通信量は管理者権限で実行しているときだけ集計されます" Foreground="#F5D99A" FontSize="11"
                               HorizontalAlignment="Right" Margin="0,4,0,0"
                               Visibility="{Binding IsNotElevated, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="最も多く通信している国" Foreground="{StaticResource FgDim}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TopName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Up}"/>
                        <TextBlock Text="{Binding TopDetail}" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource FgDim}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 下部：GeoIP の情報 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="GeoIP データベースを更新" Padding="8,2" Command="{Binding UpdateDbCommand}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DbMessage}" Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource FgDim}">
                    <Run Text="{Binding DbStatus, Mode=OneWay}"/>
                    <Run Text="　"/>
                    <Hyperlink Command="{Binding OpenDbIpCommand}" Foreground="{StaticResource Accent}">IP Geolocation by DB-IP</Hyperlink>
                    <Run Text="（CC BY 4.0）／ 地図：Natural Earth"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="250"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="230" MinHeight="100"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="430" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 地図 -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="12">
                <Viewbox Stretch="Uniform">
                    <ItemsControl ItemsSource="{Binding MapCountries}" Width="1440" Height="568">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="1440" Height="568" Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Path Data="{Binding Geometry}" Fill="{Binding Fill}" Stroke="#1E1F22" StrokeThickness="0.7"
                                      StrokeLineJoin="Round" Cursor="Hand" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="150">
                                    <Path.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding DataContext.SelectCountryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding Iso}"/>
                                    </Path.InputBindings>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="White"/>
                                                    <Setter Property="StrokeThickness" Value="2"/>
                                                    <Setter Property="Panel.ZIndex" Value="10"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="10"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Viewbox>

                <!-- 凡例 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#CC1E1F22" CornerRadius="4" Padding="10,6">
                    <StackPanel>
                        <Border Width="180" Height="10" CornerRadius="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#22406A" Offset="0"/>
                                    <GradientStop Color="#3478E0" Offset="0.25"/>
                                    <GradientStop Color="#36B3B0" Offset="0.5"/>
                                    <GradientStop Color="#E8C547" Offset="0.75"/>
                                    <GradientStop Color="#F0743C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MaxLabel}" FontSize="11" Foreground="{StaticResource FgDim}"/>
                            <TextBlock Text="少" FontSize="11" Foreground="{StaticResource FgDim}"/>
                        </DockPanel>
                        <TextBlock Text="（対数スケール）" FontSize="10" Foreground="{StaticResource FgDim}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- ランキング -->
            <DockPanel Grid.Row="0" Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="国・地域ランキング" FontWeight="SemiBold" Foreground="{StaticResource FgDim}" Margin="12,10,12,6"/>
                <ListBox ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" Background="{StaticResource Panel}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#34363C"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Selected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Rank}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FgDim}" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontFamily="Consolas">
                                            <Run Text="{Binding ValueText, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text="{Binding ShareText, Mode=OneWay}" Foreground="{StaticResource FgDim}"/>
                                        </TextBlock>
                                        <Rectangle Width="10" Height="10" Fill="{Binding Swatch}" Margin="0,0,6,0" RadiusX="2" RadiusY="2"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <!-- 割合バー -->
                                    <Grid Height="4" Margin="0,4,0,4">
                                        <Border Background="{StaticResource Bg}" CornerRadius="2"/>
                                        <Border HorizontalAlignment="Left" Background="{Binding Swatch}" CornerRadius="2">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource ShareWidth}">
                                                    <Binding Path="Share"/>
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource FgDim}"/>
                                    <TextBlock Text="{Binding Processes}" FontSize="11" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>

            <!-- 選択した国の宛先 IP -->
            <DockPanel Grid.Row="2" Grid.ColumnSpan="3">
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTitle}" FontWeight="SemiBold" Foreground="{StaticResource FgDim}" Margin="12,8,12,6"/>
                <DataGrid ItemsSource="{Binding SelectedIps}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="宛先 IP" Binding="{Binding Ip}" Width="230" ElementStyle="{StaticResource MonoCell}"/>
                        <DataGridTextColumn Header="ホスト名" Binding="{Binding Host}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="プロセス" Binding="{Binding Processes}" Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="接続数" Binding="{Binding Connections}" Width="70" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="送信" Binding="{Binding SentText}" SortMemberPath="Sent" Width="90" ElementStyle="{StaticResource UpCell}"/>
                        <DataGridTextColumn Header="受信" Binding="{Binding ReceivedText}" SortMemberPath="Received" Width="90" ElementStyle="{StaticResource DownCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
